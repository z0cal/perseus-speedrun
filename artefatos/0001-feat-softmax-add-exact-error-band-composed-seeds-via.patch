+def band_offsets(x, n, eps):
+    """Offsets of the exact nonnegative root bands relative to exp(x/n).
+    From composed_frontier.py (Exact Band Theorem).
+    """
+    seed = np.exp(x / n)
+    target = np.exp(x)
+    upper = seed * np.expm1(np.log1p(eps / target) / n)
+    lower = -seed.copy()
+    positive = target > eps
+    lower[positive] = seed[positive] * np.expm1(np.log1p(-eps / target[positive]) / n)
+    # Small numerical guard inside the positive branch (non-negativity constraint)
+    lower = np.maximum(lower, 1e-10 - seed)
+    return seed, lower, upper
+
+
+def fit_composed_seed(a, b, degree, k, eps=1e-3, max_iter=16, grid_nodes=8193):
+    """Find a Chebyshev polynomial seed P_d(t), t in [-1, 1], such that
+    H(x) = (P_d( (2x - (a+b))/(b-a) ))^(2^k) satisfies
+    |H(x) - exp(x)| <= eps on [a, b], with P_d(t) >= 0.
+
+    Uses HiGHS LP solver with iterative constraint refinement at extrema/violation points.
+    Returns:
+        (coeffs, info_dict) where coeffs is np.ndarray of shape (degree+1,), dtype np.float64.
+    """
+    n = 1 << k
+    t = np.cos(np.linspace(0.0, np.pi, 513))
+    check = np.unique(np.r_[np.linspace(-1.0, 1.0, grid_nodes),
+                            np.cos(np.linspace(0.0, np.pi, grid_nodes))])
+    ref = ch.chebfit(t, np.exp(((a + b) / 2.0 + (b - a) * t / 2.0) / n), degree)
+    status = 'refinement_limit'
+
+    for iteration in range(max_iter):
+        x = (a + b) / 2.0 + (b - a) * t / 2.0
+        seed, lower, upper = band_offsets(x, n, eps)
+        radius = (upper - lower) / 2.0
+        if np.any(radius <= 0):
+            return None, {'status': 'empty_guarded_band'}
+        scale = float(np.median(radius))
+        ref_error = ch.chebval(t, ref) - seed
+        A = ch.chebvander(t, degree) * scale / radius[:, None]
+        result = linprog(np.zeros(degree + 1), A_ub=np.vstack([A, -A]),
+                         b_ub=np.r_[(upper - ref_error) / radius,
+                                    (ref_error - lower) / radius],
+                         bounds=[(None, None)] * (degree + 1), method='highs',
+                         options={'primal_feasibility_tolerance': 1e-9,
+                                  'dual_feasibility_tolerance': 1e-9})
+        if not result.success:
+            return None, {'status': 'lp_failure', 'solver_status': result.status,
+                          'message': result.message}
+        co = ref + scale * result.x
+        roots = ch.chebroots(ch.chebder(co))
+        real = roots[np.abs(roots.imag) < 1e-10].real
+        real = real[(real > -1.0) & (real < 1.0)]
+        validation = np.unique(np.r_[check, real])
+        xx = (a + b) / 2.0 + (b - a) * validation / 2.0
+        ss, lo, hi = band_offsets(xx, n, eps)
+        pp = ch.chebval(validation, co)
+        normalized = np.maximum(pp - ss - hi, lo - (pp - ss)) / ((hi - lo) / 2.0)
+        worst = float(np.max(normalized))
+        minimum = float(np.min(pp))
+        if worst <= 1e-5 and minimum >= 0.0:
+            actual_err = float(np.max(np.abs(pp ** n - np.exp(xx))))
+            return co.astype(np.float64), {
+                'status': 'numerically_feasible',
+                'iterations': iteration + 1,
+                'min_seed': minimum,
+                'max_normalized_band_violation': worst,
+                'actual_max_abs_err': actual_err,
+                'eps': eps,
+            }
+        bad = np.flatnonzero(normalized > 1e-5)
+        selected = bad[np.argsort(normalized[bad])[-32:]]
+        t = np.unique(np.r_[t, validation[selected], real[pp[np.searchsorted(validation, real)] < 0]])
+
+    return None, {'status': status}
+
+
+def cheb_exp_composed_series(lo, hi, degree, k, eps=1e-3, max_iter=16):
+    """Generate Chebyshev coefficients for the composed exponential seed P_d(y) on [lo, hi],
+    such that (P_d(y))^(2^k) approximates exp(2^k * y) with error <= eps and P_d(y) >= 0.
+    Falls back to bisection or classical fit if target eps is infeasible on the given domain.
+    """
+    n = 1 << k
+    a = lo * n
+    b = hi * n
+    co, info = fit_composed_seed(a, b, degree, k, eps, max_iter=max_iter)
+    if co is not None and info['status'] == 'numerically_feasible':
+        return co
+
+    # If target eps fails (e.g. interval too broad or degree too small), try Boyd-Vandenberghe bisection
+    lo_e, hi_e = eps, 0.05
+    best_co = None
+    for _ in range(10):
+        mid_e = (lo_e + hi_e) / 2.0
+        c_try, i_try = fit_composed_seed(a, b, degree, k, mid_e, max_iter=12)
+        if c_try is not None and i_try['status'] == 'numerically_feasible':
+            hi_e = mid_e
+            best_co = c_try
+        else:
+            lo_e = mid_e
+    if best_co is not None:
+        log.info(f"[composed_seed] Bisected eps={hi_e:.4e} on [{a}, {b}] for d={degree}, k={k}")
+        return best_co
+
+    # Fallback to classical Chebyshev series if LP is completely infeasible
+    log.warning(f"[composed_seed] Fallback to classic Chebyshev on [{lo}, {hi}]")
+    return cheb_exp_series(lo, hi, degree)
+
+
