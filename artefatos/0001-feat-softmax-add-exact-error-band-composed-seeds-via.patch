+"""Unit tests for Composed Seeds via Exact Error Bands (LP HiGHS).
+Validates Candidates A (d=3, k=3), B (d=8, k=1), and C (d=4, k=2).
+"""
+import numpy as np
+import pytest
+from numpy.polynomial import chebyshev as ch
+
+from perseus.calibrate.numerics import band_offsets, fit_composed_seed, cheb_exp_composed_series
+from perseus.impl.ops import NumpyOps
+from perseus.impl.poly import eval_chebyshev
+
+
+def test_band_offsets_properties():
+    x = np.linspace(-32.0, 0.0, 1000)
+    n = 8
+    eps = 1e-3
+    seed, lower, upper = band_offsets(x, n, eps)
+    
+    # Check that seed = exp(x/n)
+    assert np.allclose(seed, np.exp(x / n))
+    # Check that lower and upper bounds are valid
+    assert np.all(upper > 0)
+    assert np.all(upper > lower)
+    # Check exact band definition: (seed + upper)^n == exp(x) + eps
+    U_n = (seed + upper) ** n
+    assert np.allclose(U_n, np.exp(x) + eps, rtol=1e-5)
+
+
+@pytest.mark.parametrize("d,k,a,b,eps_target", [
+    (3, 3, -32.0, 0.0, 1.0e-3),   # Candidate A (Min Mults)
+    (8, 1, -32.0, 0.0, 1.0e-3),   # Candidate B (Min Levels)
+    (4, 2, -23.0, 0.0, 1.0e-3),   # Candidate C (GPT-2 span)
+    (5, 2, -32.0, 0.0, 1.0e-3),   # Candidate C5 (Degree 5 on [-32, 0])
+])
+def test_composed_seed_feasibility_and_nonnegativity(d, k, a, b, eps_target):
+    co, info = fit_composed_seed(a, b, d, k, eps=eps_target)
+    assert co is not None, f"LP failed to converge for d={d}, k={k} on [{a}, {b}]: {info}"
+    assert info["status"] == "numerically_feasible"
+    assert info["min_seed"] >= 0.0, f"Seed has negative values: {info['min_seed']}"
+    assert info["actual_max_abs_err"] <= eps_target * (1.0 + 1e-4)
+
+    # Detailed evaluation over dense grid
+    x = np.linspace(a, b, 20000)
+    t = (2.0 * x - (a + b)) / (b - a)
+    p = ch.chebval(t, co)
+    assert np.all(p >= 0.0), "Pointwise seed violation of non-negativity"
+    
+    h = p ** (1 << k)
+    err = np.abs(h - np.exp(x))
+    assert np.max(err) <= eps_target * (1.0 + 1e-4)
+
+
+def test_cheb_exp_composed_series_interface():
+    # lo=-4.0, hi=0.0 with k=3 corresponds to x in [-32, 0]
+    co = cheb_exp_composed_series(-4.0, 0.0, 3, 3, eps=1e-3)
+    assert len(co) == 4  # degree 3 -> 4 coeffs
+    assert np.all(np.isfinite(co))
+
+
+def test_numpyops_eval_chebyshev_evaluation():
+    co, _ = fit_composed_seed(-32.0, 0.0, 3, 3, eps=1e-3)
+    ops = NumpyOps()
+    x = np.linspace(-32.0, 0.0, 501)
+    # Perseus eval_chebyshev in NumpyOps:
+    val = eval_chebyshev(ops, x, co.tolist(), -32.0, 0.0)
+    for _ in range(3):
+        val = ops.square(val)
+    err = np.abs(val - np.exp(x))
+    assert np.max(err) <= 1.0e-3 * (1.0 + 1e-5)
