+    /// Op census: the even program does fewer products, rescales and weighted-sum terms than the shipped one.
+    #[test]
+    fn even_is_cheaper() {
+        let st = tables(ChainSpec::n32sp());
+        let top = (0..=st.l as i32).rev().find(|&t| st.drop[t as usize] > 0 && {
+            let sf = st.sf(t).unwrap();
+            build_evalmod_opts(&st, FMeta { top: t, nl: 2, nf: sf * sf }, &PsPlan::evalmod(), 5, true).is_ok()
+        }).unwrap();
+        let sf = st.sf(top).unwrap();
+        let input = FMeta { top, nl: 2, nf: sf * sf };
+        let census = |ps: &PsPlan| {
+            let (p, _) = build_evalmod_opts(&st, input, ps, 5, true).unwrap();
+            let ops = p.fused();
+            let (mut mult, mut resc, mut wsum, mut limbs) = (0, 0, 0, [0usize; 3]);
+            for o in &ops {
+                match o {
+                    EmOp::Mult { n, .. } | EmOp::MultAcc { n, .. } => {
+                        mult += 1;
+                        limbs[0] += n;
+                    }
+                    EmOp::Rescale { n, .. } => {
+                        resc += 1;
+                        limbs[1] += n;
+                    }
+                    EmOp::WSum { n, srcs, .. } => {
+                        wsum += srcs.len();
+                        limbs[2] += n * srcs.len();
+                    }
+                    _ => {}
+                }
+            }
+            (mult, resc, wsum, limbs)
+        };
+        let (a, e) = (census(&PsPlan::evalmod()), census(&PsPlan::evalmod_even()));
+        println!("[even] n32sp top {top}: shipped mult/rescale/wsum terms {:?}, limbs {:?}; even {:?}, limbs {:?}", (a.0, a.1, a.2), a.3, (e.0, e.1, e.2), e.3);
+        assert!(e.0 <= a.0 && e.1 <= a.1 && e.2 < a.2, "even not cheaper: {a:?} vs {e:?}");
+        assert!(e.3.iter().sum::<usize>() < a.3.iter().sum::<usize>());
