+    /// On every chain the runtime builds and at every input top and degree where the shipped series builds, the even
+    /// series builds too and ends at the shipped output's level, degree and scale (bit for bit): no landing changes.
+    #[test]
+    fn even_lands_as_shipped() {
+        let (sh, ev) = (PsPlan::evalmod(), PsPlan::evalmod_even());
+        for (name, spec) in specs() {
+            let st = tables(spec);
+            let mut n = 0;
+            for top in 0..=st.l as i32 {
+                if st.drop[top as usize] == 0 {
+                    continue;
+                }
+                let sf = st.sf(top).unwrap();
+                for (nl, nf) in [(1, sf), (2, sf * sf)] {
+                    let input = FMeta { top, nl, nf };
+                    for lean in [false, true] {
+                        let Ok((_, a)) = build_evalmod_opts(&st, input, &sh, 5, lean) else { continue };
+                        let (_, e) = build_evalmod_opts(&st, input, &ev, 5, lean)
+                            .unwrap_or_else(|err| panic!("{name} top {top} nl {nl} lean {lean}: even fails: {err}"));
+                        assert_eq!((a.top, a.nl, a.nf.to_bits()), (e.top, e.nl, e.nf.to_bits()), "{name} top {top} nl {nl} lean {lean}");
+                        n += 1;
+                    }
+                }
+            }
+            assert!(n > 0, "{name}: no input top builds");
+            println!("[even] {name}: {n} (top, degree, lean) inputs land as the shipped series");
+        }
+    }
