+//! Levels an EvalMod series consumes on the n32 chain: `cargo run -p pc-shadow --example em_depth -- [COEFFS.json DA]`.
+//! COEFFS.json: a JSON array of Chebyshev coefficients (OpenFHE convention, c0 not halved); no argument = the
+//! shipped table and SparseB's K = 24 one. Prints the input top, the output top and their difference.
+use pc_shadow::evalmod::{build_evalmod, PsPlan};
+use pc_core::scale::ScaleTables;
+use pc_shadow::fides::FMeta;
+
+fn levels(st: &ScaleTables, coeffs: &[f64], da: i32, top: i32) -> (i32, usize) {
+    let input = FMeta { top, nl: 2, nf: st.sf(top).unwrap() * st.sf(top).unwrap() };
+    let ps = PsPlan::from_coeffs(coeffs).expect("PS plan");
+    let (prog, out) = build_evalmod(st, input, &ps, da).expect("build");
+    (top - out.top, prog.ops.len())
+}
+
+fn main() {
+    let chain = pc_core::params::Chain::generate(&pc_core::params::ChainSpec::n32()).expect("n32 chain");
+    let st = ScaleTables::precompute(&chain).expect("tables");
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let mut tables: Vec<(String, Vec<f64>, i32)> = vec![];
+    if args.len() >= 2 {
+        let c: Vec<f64> = serde_json::from_str(&std::fs::read_to_string(&args[0]).unwrap()).unwrap();
+        tables.push((args[0].clone(), c, args[1].parse().unwrap()));
+    } else {
+        tables.push(("shipped deg-14 K16".into(), pc_core::bts_setup::evalmod_coeffs().to_vec(), 5));
+        tables.push(("SparseB deg-20 K24".into(), pc_core::bts_setup::SPARSE_B_CHEB_K24.to_vec(), 5));
+    }
+    for (name, c, da) in &tables {
+        for top in [45, 51] {
+            let (l, n) = levels(&st, c, *da, top);
+            println!("{name}: degree {} + {da} double angles, in top {top}: {l} levels, {n} ops", c.len() - 1);
+        }
+    }
+}
