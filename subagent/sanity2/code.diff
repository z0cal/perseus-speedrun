+/// Double-angle iterations after the degree-27 series (both K).
+pub const D27_DA_ITS: u32 = 4;
+
+/// The EvalMod series every route of a session runs (`bts.evalmod`, FIDESLIB_BTS_EVALMOD): the dense route's K = 16
+/// table and SparseB's / the classic sparse routes' K = 24 one, each with its double angles. It sets how deep a
+/// refresh lands, so it binds the plan: a plan made for one does not compile for the other.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum EvalMod {
+    /// FIDESlib's tables (`EVALMOD_CHEB`, `SPARSE_B_CHEB_K24`), 5 double angles, 10 levels.
+    #[default]
+    Shipped,
+    /// The degree-27 tables (`EVALMOD_CHEB_D27`, `SPARSE_B_CHEB_K24_D27`), 4 double angles, 9 levels.
+    D27,
+    /// `D27` on the sparse routes (SparseB, whichever K it runs, and the classic sparse ones), `Shipped` on the dense
+    /// and StC-first routes: a series per route family (`dense_route` / `sparse_route`), not one series.
+    D27Sparse,
+}
+
+impl EvalMod {
+    /// The series a `bts.evalmod` value names: unset or "shipped", "d27", or "d27sb" (d27 on the sparse routes only).
+    pub fn named(name: Option<&str>) -> Option<EvalMod> {
+        match name {
+            None | Some("") | Some("shipped") => Some(EvalMod::Shipped),
+            Some("d27") => Some(EvalMod::D27),
+            Some("d27sb") => Some(EvalMod::D27Sparse),
+            Some(_) => None,
+        }
+    }
+
+    /// The series the tools run (`pc-bench`, `pc-check`): FIDESLIB_BTS_EVALMOD from the environment, as a session
+    /// reads `bts.evalmod` from its Config.
+    pub fn from_env() -> std::result::Result<EvalMod, String> {
+        let v = std::env::var("FIDESLIB_BTS_EVALMOD").ok();
+        EvalMod::named(v.as_deref()).ok_or_else(|| format!("FIDESLIB_BTS_EVALMOD={v:?}: shipped | d27 | d27sb"))
+    }
+
+    /// The series the dense and StC-first routes run.
+    pub fn dense_route(self) -> EvalMod {
+        match self {
+            EvalMod::D27Sparse => EvalMod::Shipped,
+            em => em,
+        }
+    }
+
+    /// The series the sparse routes run (SparseB, classic sparse).
+    pub fn sparse_route(self) -> EvalMod {
+        match self {
+            EvalMod::D27Sparse => EvalMod::D27,
+            em => em,
+        }
+    }
+
+    /// The K = 16 (dense) table.
+    pub fn dense(self) -> &'static [f64] {
+        match self {
+            EvalMod::Shipped => &EVALMOD_CHEB,
+            EvalMod::D27 => &EVALMOD_CHEB_D27,
+            EvalMod::D27Sparse => panic!("EvalMod::D27Sparse is per route: dense_route() / sparse_route() first"),
+        }
+    }
+
+    /// The K = 24 (SparseB, classic sparse) table.
+    pub fn sparse_k24(self) -> &'static [f64] {
+        match self {
+            EvalMod::Shipped => &SPARSE_B_CHEB_K24,
+            EvalMod::D27 => &SPARSE_B_CHEB_K24_D27,
+            EvalMod::D27Sparse => panic!("EvalMod::D27Sparse is per route: dense_route() / sparse_route() first"),
+        }
+    }
+
+    /// Double-angle iterations after either table.
+    pub fn da_its(self) -> u32 {
+        match self {
+            EvalMod::Shipped => EVALMOD_DA_ITS,
+            EvalMod::D27 => D27_DA_ITS,
+            EvalMod::D27Sparse => panic!("EvalMod::D27Sparse is per route: dense_route() / sparse_route() first"),
+        }
+    }
+
+    /// CKKS levels the series consumes on the n32 chain, both K (pc-shadow `evalmod::build_evalmod`; checked there).
+    pub fn levels(self) -> u32 {
+        match self {
+            EvalMod::Shipped => 10,
+            EvalMod::D27 => 9,
+            EvalMod::D27Sparse => panic!("EvalMod::D27Sparse is per route: dense_route() / sparse_route() first"),
+        }
+    }
+}
